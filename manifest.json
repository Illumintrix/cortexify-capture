{
  "manifest_version": 3,
  "name": "Cortexify Capture",
  "version": "1.0.0",
  "description": "Save pages, tab groups, selections, and documents to Cortexify without breaking your flow.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.cortexify.in/*",
    "https://cortexify.in/*",
    "https://tfbujtucezcpxdzlhqrj.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Cortexify",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cortexify.in/*",
        "https://cortexify.in/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save the current page"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
